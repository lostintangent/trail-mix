{
  "name": "trail-mix",
  "description": "An open-source, self-hosted mail client that runs as one Cloudflare Worker",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.stylex.ts"
  ],
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js dev",
    "build": "bun --bun vite build",
    "check": "bun check --no-script -b",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test:mail": "bun tests/mail-server/server.ts prepare && bun test --path-ignore-patterns=node_modules/** tests/mail-server tests/mail-check tests/contract tests/reader/demo.mail.test.ts tests/mail-clients tests/accounts src/features/mailroom",
    "mail-server": "bun tests/mail-server/server.ts",
    "mail-check": "bun tests/mail-check/check.ts",
    "types": "node node_modules/wrangler/bin/wrangler.js types --include-env=false",
    "theme": "bun --bun astryx theme build src/app/theme/trail-mix.ts --out src/app/theme/built/trail-mix.css",
    "bench": "bun tests/bench/run.ts",
    "e2e": "bun test ./tests/e2e/workbench.e2e.ts ./tests/e2e/calls.e2e.ts ./tests/e2e/triage.e2e.ts ./tests/e2e/composer.e2e.ts ./tests/e2e/outbox.e2e.ts ./tests/e2e/folders.e2e.ts ./tests/e2e/reader.e2e.ts ./tests/e2e/accounts.e2e.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@astryxdesign/theme-neutral": "0.7.11",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-virtual": "3.14.26",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-paragraph": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/markdown": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "dompurify": "3.4.17",
    "imapflow": "2.11.0",
    "jose": "6.2.17",
    "lucide-react": "1.71.0",
    "marked": "17.0.6",
    "nodemailer": "10.4.0",
    "postal-mime": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.11",
    "@cloudflare/vite-plugin": "1.68.0",
    "@stylexjs/unplugin": "0.19.1",
    "@tanstack/virtual-file-routes": "1.162.0",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "lightningcss": "1.33.0",
    "playwright": "1.65.0",
    "smtp-server": "3.21.3",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  }
}
