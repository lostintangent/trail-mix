// Two programs, since the browser and the Worker run against different globals. `bun check`
// checks both: the browser's against the DOM, and the Worker's against the Workers runtime that
// `bun run types` describes in `worker-configuration.d.ts`. A module both import, such as
// `mail/core` or the client contract, has to type-check in each.
{
  "files": [],
  "references": [{ "path": "./tsconfig.browser.json" }, { "path": "./tsconfig.worker.json" }],
  "compilerOptions": {
    // Environment
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"],

    // Modules: Bun and Vite resolve and transpile, nothing is emitted
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Strictness
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  }
}
